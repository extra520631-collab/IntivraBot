# ── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed origins (frontend URLs)
CLIENT_URLS=http://localhost:5173

# ── Database ───────────────────────────────────────────
# MongoDB Atlas connection string (free M0 cluster)
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/intivrabot

# ── Auth ───────────────────────────────────────────────
# Use a long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Integrations (added in later phases) ───────────────
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=
CLOUDINARY_URL=
