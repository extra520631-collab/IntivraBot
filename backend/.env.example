# ── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed origins (frontend URLs)
CLIENT_URLS=http://localhost:5173

# ── Database ───────────────────────────────────────────
# MongoDB Atlas connection string (free M0 cluster)
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/intivrabot

# ── Auth ───────────────────────────────────────────────
# Use a long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Integrations (added in later phases) ───────────────
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=
CLOUDINARY_URL=

# Outgoing mail for password resets (optional).
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below without spaces.
# Leave blank to skip email - the reset link is then returned in the API
# response outside production so the flow still works locally.
MAIL_USER=
MAIL_PASS=
